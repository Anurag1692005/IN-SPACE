#include <HardwareSerial.h>
#include <TinyGPSPlus.h>
#include <SoftwareSerial.h>

// =====================================================
// RYLR890 LORA
// =====================================================

HardwareSerial LoRaSerial(1);

#define LORA_RX 18
#define LORA_TX 19


// =====================================================
// XBEE 3
// =====================================================

HardwareSerial XBeeSerial(2);

#define XBEE_RX 6
#define XBEE_TX 7


// =====================================================
// GY-GPS6MV2
// =====================================================

SoftwareSerial GPSSerial;

#define GPS_RX 4
#define GPS_TX 5   // Nothing needs to be connected here

TinyGPSPlus gps;


// =====================================================
// VARIABLES
// =====================================================

unsigned long lastSend = 0;
unsigned long lastStatus = 0;

unsigned long packetNumber = 0;


// =====================================================
// SETUP
// =====================================================

void setup()
{
  Serial.begin(115200);

  delay(2000);


  // ===================================================
  // LORA
  // ===================================================

  LoRaSerial.begin(
    115200,
    SERIAL_8N1,
    LORA_RX,
    LORA_TX
  );


  // ===================================================
  // XBEE
  // ===================================================

  XBeeSerial.begin(
    9600,
    SERIAL_8N1,
    XBEE_RX,
    XBEE_TX
  );


  // ===================================================
  // GPS
  // ===================================================

  GPSSerial.begin(
    9600,
    SWSERIAL_8N1,
    GPS_RX,
    GPS_TX,
    false
  );


  Serial.println();
  Serial.println("==========================================");
  Serial.println(" GPS + LORA + XBEE TELEMETRY");
  Serial.println("==========================================");

  Serial.println("LoRa : GPIO18 / GPIO19");
  Serial.println("XBee : GPIO6 / GPIO7");
  Serial.println("GPS  : TX -> GPIO4");

  Serial.println();
  Serial.println("Waiting for GPS satellite fix...");
}


// =====================================================
// MAIN LOOP
// =====================================================

void loop()
{
  // ===================================================
  // READ GPS CONTINUOUSLY
  // ===================================================

  while (GPSSerial.available())
  {
    char c = GPSSerial.read();

    gps.encode(c);
  }


  // ===================================================
  // SHOW GPS STATUS EVERY 2 SECONDS
  // ===================================================

  if (millis() - lastStatus >= 2000)
  {
    lastStatus = millis();

    Serial.println();
    Serial.println("---------- GPS STATUS ----------");

    Serial.print("GPS Characters: ");
    Serial.println(gps.charsProcessed());

    Serial.print("GPS Fix: ");

    if (gps.location.isValid())
    {
      Serial.println("YES");
    }
    else
    {
      Serial.println("NO");
    }

    Serial.print("Satellites: ");

    if (gps.satellites.isValid())
    {
      Serial.println(gps.satellites.value());
    }
    else
    {
      Serial.println("0");
    }

    Serial.println("--------------------------------");
  }


  // ===================================================
  // SEND TELEMETRY EVERY 1 SECOND
  // ===================================================

  if (gps.location.isValid())
  {
    if (millis() - lastSend >= 1000)
    {
      lastSend = millis();

      packetNumber++;

      sendTelemetry();
    }
  }


  // ===================================================
  // READ LORA RESPONSE
  // ===================================================

  while (LoRaSerial.available())
  {
    Serial.print("LORA RESPONSE: ");

    while (LoRaSerial.available())
    {
      Serial.write(LoRaSerial.read());
    }

    Serial.println();
  }
}


// =====================================================
// TELEMETRY FUNCTION
// =====================================================

void sendTelemetry()
{
  String telemetry = "";

  // Team
  telemetry += "TEAM:062";

  // Packet number
  telemetry += ",PKT:";
  telemetry += String(packetNumber);

  // Latitude
  telemetry += ",LAT:";
  telemetry += String(gps.location.lat(), 6);

  // Longitude
  telemetry += ",LON:";
  telemetry += String(gps.location.lng(), 6);


  // ===================================================
  // ALTITUDE
  // ===================================================

  if (gps.altitude.isValid())
  {
    telemetry += ",ALT:";
    telemetry += String(gps.altitude.meters(), 1);
  }


  // ===================================================
  // SATELLITES
  // ===================================================

  if (gps.satellites.isValid())
  {
    telemetry += ",SAT:";
    telemetry += String(gps.satellites.value());
  }


  // ===================================================
  // SPEED
  // ===================================================

  if (gps.speed.isValid())
  {
    telemetry += ",SPD:";
    telemetry += String(gps.speed.kmph(), 1);
  }


  // ===================================================
  // LOCAL SERIAL MONITOR
  // ===================================================

  Serial.println();
  Serial.println("==========================================");

  Serial.println("LIVE GPS TELEMETRY:");

  Serial.println(telemetry);


  // ===================================================
  // SEND THROUGH XBEE 3
  // ===================================================

  XBeeSerial.println(telemetry);

  Serial.println("XBEE 3 -> SENT");


  // ===================================================
  // SEND THROUGH RYLR890
  // ===================================================

  String loraCommand = "";

  loraCommand += "AT+SEND=2,";
  loraCommand += String(telemetry.length());
  loraCommand += ",";
  loraCommand += telemetry;


  LoRaSerial.println(loraCommand);


  Serial.println("LORA   -> SENT");

  Serial.print("LORA COMMAND: ");
  Serial.println(loraCommand);

  Serial.println("==========================================");
}
